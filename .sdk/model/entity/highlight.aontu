# Entity: highlight

main: kit: entity: highlight: {

  alias: field: {}

  fields: [
    {
      name: "content"
      req: false
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "timestamp"
      req: false
      type: "`$STRING`"
    }
    {
      name: "title"
      req: false
      type: "`$STRING`"
    }
    {
      name: "url"
      req: false
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "highlight"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/hljson"
          parts: [
            "hljson"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.highlights`"
          }
        }
      ]
    }
  }



}
